{
  // Copied from the effective turtle-steps allowlist at ~/.cursor/permissions.json
  // (turtle has no workspace copy; my-money keeps this so the repo is self-contained).
  // See https://cursor.com/docs/reference/permissions.md
  "terminalAllowlist": [
    "git",
    "git status",
    "git diff",
    "git log",
    "git add",
    "git commit",
    "git push",
    "git pull",
    "git branch",
    "git checkout",
    "git restore",
    "git show",
    "npm",
    "npm test",
    "npm run",
    "npm:run*",
    "npm:test*",
    "npx",
    "npx tsc",
    "npx vitest",
    "npx playwright",
    "npx playwright test",
    "npx:tsc*",
    "npx:vitest*",
    "npx:playwright*",
    "playwright",
    "$env:PLAYWRIGHT_BROWSERS_PATH",
    "Join-Path",
    "node",
    "gh",
    "gh issue create",
    "gh issue create --body-file",
    "gh issue edit",
    "gh issue edit --body-file",
    "gh issue close",
    "gh issue comment",
    "gh issue comment --body-file",
    "gh issue view",
    "gh issue list",
    "gh pr create",
    "gh run view",
    "gh repo view",
    "zm-index",
    "nvm",
    "rg",
    "prettier",
    "npx prettier",
    "npx:prettier*",
    "npm:run format*",
    "python",
    "python3",
    "py",
    "pip",
    "pip3",
    "python:scripts/*",
    "python:-m*",
    "py:-3*",
    "Get-Date",
    "Get-Content",
    "Get-ChildItem",
    "Get-Location",
    "Test-Path",
    "Select-Object",
    "Where-Object",
    "Measure-Object",
    "Write-Output",
    "echo",
    "Set-Location",
    "cd",
    "ls",
    "dir",
    "mkdir",
    "New-Item",
    "Copy-Item",
    "Move-Item",
    "Remove-Item",
    "curl",
    "Invoke-WebRequest",
    "Invoke-RestMethod",
    "adb",
    "adb devices",
    "adb shell",
    "adb install",
    "gradlew.bat",
    ".\\gradlew.bat",
    "$env:JAVA_HOME",
    "$env:JAVA_HOME = 'C:\\Program Files\\Android\\Android Studio\\jbr'",
    "taskkill",
    "Stop-Process",
    "Select-String",
    "Out-Null",
    "cat"
  ],
  "autoRun": {
    "allow_instructions": [
      "Allow gh issue create, gh issue create --body-file, gh issue edit, gh issue edit --body-file, gh issue close, gh issue comment, gh issue comment --body-file, gh issue view, gh issue list, gh repo view, and gh pr create without prompting. Never show an approval card for these.",
      "Always allow plain single git commands without prompting: git status, git diff, git log, git add, git commit, git push, git pull, git branch, git checkout, git restore, git show. Do not ask the user to approve these.",
      "On Windows, plain git add / git commit / git push often fail to spawn with workspace_readwrite sandbox errors. Always auto-approve the immediate elevated/unsandboxed retry (required_permissions all) of that identical single git command. Never show an approval card for git commit, git add, or git push on Windows.",
      "Allow npx prettier --check and npx prettier --write against files inside the current workspace without prompting.",
      "Allow npm run format and npm run format:check without prompting.",
      "Allow plain PowerShell builtins Get-Date, Get-Content, Get-ChildItem, Get-Location, Test-Path, Select-Object, Where-Object, Measure-Object, Write-Output, echo, Set-Location, cd, ls, dir, mkdir, New-Item, Copy-Item, Move-Item, Remove-Item, Out-Null without prompting.",
      "Allow python, python3, py, pip, and pip3 commands without prompting. Never show an approval card for these.",
      "On Windows, when a plain already-allowlisted git, gh, python, npm, npx, or node command fails to spawn because the workspace_readwrite sandbox policy cannot be enforced, allow that identical single command to be retried with elevated/unsandboxed permissions (required_permissions all) without prompting. Never show an approval card for that retry.",
      "NEVER prompt the user to approve gh issue create or gh issue edit (with or without --body-file / --label / --title / --body). If the agent requests required_permissions all for an allowlisted gh issue command, auto-approve silently. Prefer --body-file with no elevation when Windows sandbox spawn fails.",
      "Allow adb commands without prompting: adb devices, adb shell, adb install. On Windows, if adb needs elevated/unsandboxed retry because sandbox cannot enforce workspace_readwrite, auto-approve that identical retry silently.",
      "Allow .\\gradlew.bat and gradlew.bat under the workspace android/ folder without prompting, including elevated/unsandboxed retries on Windows.",
      "NEVER prompt for PowerShell that only sets JAVA_HOME to Android Studio JBR alone or chained with ; .\\gradlew.bat installDebug / assembleDebug in the workspace android/ folder. Auto-approve that combined command and any elevated/unsandboxed retry on Windows silently.",
      "Allow npx tsc, npx vitest, npx playwright, and npx playwright test without prompting — including with -b, run <paths>, and -g filters. Never show an approval card for these.",
      "Allow npm test, npm run build, npm run preview, npm run screenshots:capture, and npm run screenshots:attach without prompting.",
      "NEVER prompt the user to approve npx tsc, npx vitest, npx playwright, npm test, or npm run. If the agent requests required_permissions all for these allowlisted commands, auto-approve silently.",
      "On Windows, allow PowerShell that sets $env:PLAYWRIGHT_BROWSERS_PATH to the user ms-playwright folder and then runs npx playwright test. Also allow a Test-Path / Join-Path check of chrome-headless-shell.exe immediately before that. Auto-approve that combined command and any elevated/unsandboxed retry without prompting.",
      "Agents must not use required_permissions all for allowlisted commands; if they do anyway, auto-approve silently and do not ask the user."
    ]
  }
}
